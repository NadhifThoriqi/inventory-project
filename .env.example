# =============================================================================
# .env.example — template konfigurasi.
#
# Cara pakai:
#     cp .env.example .env        (Windows: copy .env.example .env)
# lalu isi nilai aslinya di .env.  File .env JANGAN di-commit (sudah ada di .gitignore).
#
# Catatan:
#   - .env dibaca dari folder tempat server dijalankan -> jalankan dari root proyek.
#   - Variabel environment sistem MENANG atas isi .env.
#   - Jangan tulis komentar di belakang nilai (mis. DEBUG=false # catatan),
#     karena komentar itu ikut terbaca sebagai bagian nilai.
# =============================================================================


# ---- WAJIB (server menolak start kalau tidak ada) ---------------------------

# URL database dengan driver async.
# PostgreSQL : postgresql+asyncpg://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
# SQLite     : sqlite+aiosqlite:///./thorix.db   (butuh: pip install aiosqlite)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/inventory

# Kunci rahasia untuk menandatangani JWT. Wajib acak & panjang, jangan dibagikan.
# Buat dengan:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=ganti-dengan-string-acak-yang-panjang


# ---- WAJIB: akun admin pertama ------------------------------------------------
# Dibuat otomatis saat server menyala (db/seed.py), HANYA jika tabel 'auth' masih
# kosong. Setelah ada pengguna, tiga variabel ini tidak dipakai lagi (tetap harus ada).
# Akun ini langsung terverifikasi dan berperan admin.
YOURNAME=Admin Utama
EMAIL=admin@contoh.com
PASSWORD=Ganti-Password-Ini-123!


# ---- OPSIONAL (sudah dipakai kode; nilai di bawah = nilai bawaan) -----------

# Judul aplikasi (tampil di Swagger dan /thorix-api/health).
PROJECT_NAME=Inventory Project

# Port server, juga dipakai untuk daftar origin CORS di main.py.
PORT=8000

# true  -> cetak semua query SQL ke console dan aktifkan auto-reload server.
# false -> gunakan false di produksi.
DEBUG=false

# true  -> cookie login diberi flag Secure (hanya dikirim lewat HTTPS).
# Ubah ke true jika situs sudah memakai HTTPS.
HTTPS=false

# Domain cookie login. Biarkan tidak diisi (baris di-comment) kecuali memang perlu.
# DOMAIN=contoh.com

# Algoritma tanda tangan JWT.
ALGORITHM=HS256

# Lama sesi login, keduanya dalam HARI.
# Tanpa "ingat saya":
NOT_REMEMBER_TOKEN_EXPIRE=1
# Dengan "ingat saya":
REMEMBER_TOKEN_EXPIRE=30


# ---- DIBACA config.py TAPI BELUM DIPAKAI KODE -------------------------------
# Yang berlaku untuk flag Secure pada cookie adalah HTTPS di atas.
# COOKIE_SECURE=false